
<div class="pincode-checker" id="pincode-checker-{{ block.id }}">
  <form class="pincode-checker__form" novalidate>
    <label for="pincode-input-{{ block.id }}">
      Check your postal location
    </label>

    <div class="pincode-checker__controls">
      <input
        id="pincode-input-{{ block.id }}"
        name="pincode"
        type="text"
        inputmode="numeric"
        maxlength="6"
        pattern="[1-9][0-9]{5}"
        placeholder="Enter 6-digit pincode"
        autocomplete="postal-code"
        aria-describedby="pincode-message-{{ block.id }}"
        required
      >

      <button type="submit">Check</button>
    </div>

    <p
      id="pincode-message-{{ block.id }}"
      class="pincode-checker__message"
      role="status"
      aria-live="polite"
    ></p>
  </form>
</div>

<style>
  #pincode-checker-{{ block.id }} {
    margin: 16px 0;
  }

  #pincode-checker-{{ block.id }} label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
  }

  #pincode-checker-{{ block.id }} .pincode-checker__controls {
    display: flex;
    gap: 8px;
    max-width: 440px;
  }

  #pincode-checker-{{ block.id }} input {
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    border: 1px solid #ccc;
    border-radius: 4px;
  }

  #pincode-checker-{{ block.id }} button {
    padding: 10px 16px;
    border: 0;
    border-radius: 4px;
    background: #222;
    color: #fff;
    cursor: pointer;
  }

  #pincode-checker-{{ block.id }} button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  #pincode-checker-{{ block.id }} .pincode-checker__message {
    margin: 10px 0 0;
    font-size: 14px;
  }

  @media (max-width: 480px) {
    #pincode-checker-{{ block.id }} .pincode-checker__controls {
      flex-wrap: wrap;
    }

    #pincode-checker-{{ block.id }} button {
      width: 100%;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById(
      'pincode-checker-{{ block.id }}'
    );

    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const form = root.querySelector('form');
    const input = root.querySelector('input');
    const button = root.querySelector('button');
    const message = root.querySelector('[role="status"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (button.disabled) return;

      const pincode = input.value.trim();

      message.textContent = '';

      if (!/^[1-9][0-9]{5}$/.test(pincode)) {
        message.textContent =
          'Enter a valid 6-digit Indian pincode.';
        input.focus();
        return;
      }

      button.disabled = true;
      input.setAttribute('aria-busy', 'true');
      message.textContent = 'Checking pincode...';

      try {
        const response = await fetch(
          `https://api.postalpincode.in/pincode/${pincode}`
        );

        if (!response.ok) {
          throw new Error('API request failed');
        }

        const data = await response.json();
        const result = data?.[0];
        const offices = result?.PostOffice;

        if (
          result?.Status !== 'Success' ||
          !Array.isArray(offices) ||
          offices.length === 0
        ) {
          message.textContent =
            'Pincode not found. Please check and try again.';
          return;
        }

        const office = offices.find(
          (item) => item?.District && item?.State
        );

        if (!office) {
          message.textContent =
            'Location details are unavailable for this pincode.';
          return;
        }

        message.textContent =
          `Postal location: ${office.District}, ${office.State}. ` +
          'Delivery availability is not verified.';
      } catch {
        message.textContent =
          'Unable to check right now. Please try again later.';
      } finally {
        button.disabled = false;
        input.removeAttribute('aria-busy');
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Pincode Checker",
  "target": "section",
  "settings": []
}
{% endschema %}
